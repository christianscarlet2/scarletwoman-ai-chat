# Scarlet Woman backend (server.js). LLM = Claude via /usr/local/bin/claude-jail (no API keys).
# Voice = local Piper TTS. Runs as systemd unit scarletwoman-chat (user swchat).
PORT=8000
HOST=127.0.0.1
STATE_DIR=/var/lib/scarletwoman
PIPER_VOICE=/usr/local/share/piper-voices/en_GB-cori-medium.onnx
# legacy header the pre-2026-09-24 client bundle sends (public, not a secret)
VITE_AUTH_TOKEN="..."
# frontend build (Cloudflare Pages env): where the client finds the backend
VITE_API_URL="https://swiftsnake.scarletbeast.com:8002"
